     "output_type": "stream",
     "text": [
      "roots are (3+0j) and (2-0j)\n"
     ]
    }
   ],
   "source": [
    "import cmath\n",
    "a = 1.0\n",
    "b = -5.0\n",
    "c = 6.0\n",
    "d = cmath.sqrt (b**2 - 4*a*c)\n",
    "x1 = (-b + d) / (2*a)\n",
